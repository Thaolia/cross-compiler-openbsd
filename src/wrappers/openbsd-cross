#!/bin/sh
# Multi-call wrapper for the OpenBSD/amd64 cross toolchain.
# Invoked through symlinks named x86_64-unknown-openbsd<FLAVOR>-<TOOL>, e.g.
#   x86_64-unknown-openbsd8.0-cc, x86_64-unknown-openbsdcurrent-c++
#
# Layout (relative to this script): ../sysroot/<FLAVOR>/
# env overrides: OPENBSD_SYSROOT, OPENBSD_CLANG, OPENBSD_CLANGXX, OPENBSD_LLD, OPENBSD_LLVM_BIN
set -eu

self=$(basename "$0")
# Flavors never contain '-', tool names may (pkg-config).
rest=${self#x86_64-unknown-openbsd}
flavor=${rest%%-*}
tool=${rest#*-}
[ "$rest" != "$self" ] && [ -n "$flavor" ] && [ "$tool" != "$rest" ] || {
    echo "openbsd-cross: must be invoked as x86_64-unknown-openbsd<flavor>-<tool>" >&2; exit 2; }

here=$(cd "$(dirname "$0")" && pwd -P)
sysroot=${OPENBSD_SYSROOT:-$here/../sysroot/$flavor}
[ -f "$sysroot/.sysroot-info" ] || {
    echo "openbsd-cross: no sysroot at $sysroot (run fetch-sysroot.sh $flavor ...)" >&2; exit 2; }

# The clang triple carries the release number (8.0); -current uses the number of its sets.
ver=$(sed -n 's/^version=\([0-9]\)\([0-9]\)$/\1.\2/p' "$sysroot/.sysroot-info")
target=x86_64-unknown-openbsd$ver

find_tool() {
    # $1 = env override, $2... = candidate names
    if [ -n "$1" ]; then echo "$1"; return; fi
    shift
    for c in "$@"; do
        p=$(command -v "$c" 2>/dev/null) && { echo "$p"; return; }
    done
    echo "openbsd-cross: none of [$*] found in PATH" >&2
    exit 127
}
llvmbin=${OPENBSD_LLVM_BIN:-}
pfx=${llvmbin:+$llvmbin/}

# Classify the invocation: no link step at all, or link of an executable (gets -pie
# like OpenBSD's ld does by default), or another link (shared lib, -r, static...).
link_mode() {
    mode=exe
    for a in "$@"; do
        case $a in
            -c|-S|-E|-M|-MM|--version|-print-*|-dump*) echo none; return ;;
            -shared|-r|-static|-nopie|-no-pie|-static-pie|-pie) mode=other ;;
        esac
    done
    echo $mode
}

cc_common="--target=$target --sysroot=$sysroot"

case $tool in
    cc|clang|gcc|c++|clang++|g++|cpp)
        case $tool in
            c++|clang++|g++) cc=$(find_tool "${OPENBSD_CLANGXX:-}" ${pfx}clang++ clang++ clang++-21 clang++-20 clang++-19) ;;
            *) cc=$(find_tool "${OPENBSD_CLANG:-}" ${pfx}clang clang clang-21 clang-20 clang-19) ;;
        esac
        if [ "$tool" = cpp ]; then exec "$cc" $cc_common -E "$@"; fi
        case $(link_mode "$@") in
            none) exec "$cc" $cc_common "$@" ;;
        esac
        lld=$(find_tool "${OPENBSD_LLD:-}" ${pfx}ld.lld ld.lld ld.lld-21 ld.lld-20 ld.lld-19)
        case $(link_mode "$@") in
            exe) exec "$cc" $cc_common --ld-path="$lld" -pie "$@" ;;
            *) exec "$cc" $cc_common --ld-path="$lld" "$@" ;;
        esac
        ;;
    ld)
        lld=$(find_tool "${OPENBSD_LLD:-}" ${pfx}ld.lld ld.lld ld.lld-21 ld.lld-20 ld.lld-19)
        exec "$lld" --sysroot="$sysroot" "$@"
        ;;
    ar|nm|ranlib|strip|objcopy|objdump|readelf|size|strings)
        t=$(find_tool "" ${pfx}llvm-$tool llvm-$tool llvm-$tool-21 llvm-$tool-20 llvm-$tool-19 $tool)
        exec "$t" "$@"
        ;;
    pkg-config|pkgconf)
        t=$(find_tool "" pkgconf pkg-config)
        PKG_CONFIG_SYSROOT_DIR=$sysroot
        PKG_CONFIG_LIBDIR=$sysroot/usr/lib/pkgconfig:$sysroot/usr/local/lib/pkgconfig:$sysroot/usr/X11R6/lib/pkgconfig
        PKG_CONFIG_PATH=
        export PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_LIBDIR PKG_CONFIG_PATH
        exec "$t" "$@"
        ;;
    sysroot)
        echo "$sysroot"
        ;;
    *)
        echo "openbsd-cross: unknown tool '$tool'" >&2
        exit 2
        ;;
esac
